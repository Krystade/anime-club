rules_version = '2';

// Access model (MVP): the club document id is a long random key, and the invite
// link carries it. Anyone holding the link can read and edit that club. Nobody
// can list clubs, create one, or delete one from a client; clubs are made by the
// owner through the admin API.
service cloud.firestore {
  match /databases/{db}/documents {
    function clubExists(k) {
      return exists(/databases/$(db)/documents/clubs/$(k));
    }
    function isInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }
    function nullOrStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function nullOrNum(v) {
      return v == null || v is number;
    }
    function validShow(d) {
      return d.keys().hasAll(['malId', 'title', 'image', 'eps', 'score', 'year', 'type',
                              'status', 'ep', 'by', 'recBy', 'votes', 'scores', 'log', 'addedAt', 'statusAt'])
        && d.keys().hasOnly(['malId', 'title', 'image', 'eps', 'score', 'year', 'type',
                             'status', 'ep', 'by', 'recBy', 'votes', 'scores', 'log', 'addedAt', 'statusAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['rec', 'queue', 'sampled', 'watching', 'done', 'drop']
        && isInt(d.ep, 0, 5000)
        && (d.eps == null || isInt(d.eps, 0, 5000))
        && (d.malId == null || isInt(d.malId, 1, 100000000))
        && nullOrStr(d.image, 500)
        && nullOrStr(d.type, 30)
        && nullOrNum(d.score)
        && nullOrNum(d.year)
        && d.by is string && d.by.size() <= 40
        && d.recBy is list && d.recBy.size() <= 40
        && d.votes is list && d.votes.size() <= 40
        && d.scores is map && d.scores.size() <= 40
        && d.log is list && d.log.size() <= 500
        && d.addedAt is number && d.statusAt is number;
    }
    function validClub(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && isInt(d.meetDay, 0, 6)
        && d.meetTime is string && d.meetTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.members is list && d.members.size() <= 40;
    }

    match /clubs/{k} {
      allow get: if true;
      allow list, create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'meetDay', 'meetTime', 'startTime', 'members'])
                    && validClub(request.resource.data);

      match /shows/{id} {
        allow read, delete: if clubExists(k);
        allow create, update: if clubExists(k) && validShow(request.resource.data);
      }

      // MyAnimeList lists to browse, by MAL username only (never tied to a member).
      // Adding one must bump the daily quota in the same batch, capped at MAL_DAILY_LIMIT.
      match /malLists/{user} {
        allow read, delete: if clubExists(k);
        allow update: if false;
        allow create: if clubExists(k)
          && user.matches('^[A-Za-z0-9_-]{2,16}$')
          && request.resource.data.keys().hasOnly(['addedAt', 'day'])
          && request.resource.data.addedAt is number
          && request.resource.data.day == today()
          && quotaBumpedFor(k, user);
      }
      match /meta/malQuota {
        allow read: if clubExists(k);
        allow create, update: if clubExists(k)
          && request.resource.data.keys().hasOnly(['day', 'count', 'last'])
          && request.resource.data.day == today()
          && request.resource.data.count == quotaUsed(k) + 1
          && request.resource.data.count <= 10
          && request.resource.data.last is string
          && !exists(/databases/$(db)/documents/clubs/$(k)/malLists/$(request.resource.data.last))
          && existsAfter(/databases/$(db)/documents/clubs/$(k)/malLists/$(request.resource.data.last));
        allow delete: if false;
      }
    }

    // Day number in UTC, so the quota resets at midnight UTC (4pm Pacific).
    function today() {
      return math.floor(request.time.toMillis() / 86400000);
    }
    function quotaPath(k) {
      return /databases/$(db)/documents/clubs/$(k)/meta/malQuota;
    }
    function quotaUsed(k) {
      return exists(quotaPath(k)) && get(quotaPath(k)).data.day == today() ? get(quotaPath(k)).data.count : 0;
    }
    function quotaBumpedFor(k, user) {
      let q = getAfter(quotaPath(k)).data;
      return q.day == today() && q.count == quotaUsed(k) + 1 && q.count <= 10 && q.last == user;
    }
  }
}
